# Copy this file to backend/.env and fill in real values.
# Never commit the real .env file (it is in .gitignore).

# ==============================================================================
# 1. Database Configuration (Required)
# ==============================================================================
# PostgreSQL connection string with pgvector extension enabled.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# (Both postgresql:// and postgresql+psycopg:// are supported automatically)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/studymate

# ==============================================================================
# 2. Authentication & Security (Required)
# ==============================================================================
# Secret that signs JWT login tokens (at least 32 random characters).
# Aliases accepted: SECRET_KEY, JWT_SECRET
# Generate one with PowerShell:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# Optional auth parameters:
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=false

# ==============================================================================
# 3. Google Gemini API (Required for Vision Reading & RAG Answering)
# ==============================================================================
# API key from https://aistudio.google.com
# Aliases accepted: LLM_API_KEY
GEMINI_API_KEY=
LLM_API_KEY=

# ==============================================================================
# 4. Embedding Generation (Stage 6)
# ==============================================================================
# Local 384-dimensional sentence-transformers model (CPU default, offline-capable).
# Aliases accepted: EMBEDDING_MODEL
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# ==============================================================================
# 5. Chat & Grounded RAG Generation (Stage 7)
# ==============================================================================
# Gemini model used to synthesize answers from retrieved PDF/diagram chunks.
# Aliases accepted: LLM_MODEL
CHAT_MODEL=gemini-2.5-flash
# Aliases accepted: LLM_TEMPERATURE
CHAT_TEMPERATURE=0.2
# Number of chunks retrieved per question (Alias: TOP_K)
RAG_TOP_K=5
# Minimum cosine similarity threshold (0.0 to 1.0)
RAG_SIMILARITY_THRESHOLD=0.0
# Maximum context token limit
RAG_MAX_CONTEXT_TOKENS=3000

# ==============================================================================
# 6. Upload & Vision Worker Parameters (Optional - defaults shown)
# ==============================================================================
# UPLOAD_DIR=backend/uploads
# MAX_UPLOAD_MB=50
# MAX_PDF_PAGES=500
# PROCESSING_WORKERS=2
# PAGE_IMAGE_LONG_SIDE=2000
# VISION_MODEL=gemini-3.8-flash
# VISION_FALLBACK_MODEL=gemini-3.5-flash-lite
# VISION_MODEL_RPM=5
# VISION_MODEL_RPD=20
# VISION_FALLBACK_RPM=15
# VISION_FALLBACK_RPD=500
# VISION_PAGES_PER_REQUEST=5
# VISION_MAX_ATTEMPTS=3
