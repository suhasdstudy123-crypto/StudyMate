# Copy this file to backend/.env and fill in real values.
# Never commit the real .env file (it is in .gitignore).

# PostgreSQL connection string (pgvector-enabled database)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:your_password@localhost:5433/studymate

# Secret that signs JWT login tokens (Stage 3). At least 32 random characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# Optional: how long a login lasts, in minutes (default 1440 = 1 day)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional: "true" in production (HTTPS) so the auth cookie is never sent over plain http
COOKIE_SECURE=false

# Optional, uploads (Stage 5). Defaults shown.
# UPLOAD_DIR=          (default: backend/uploads)
# MAX_UPLOAD_MB=50
# MAX_PDF_PAGES=500
# PROCESSING_WORKERS=2

# Image reader (Stage 5b): Google Gemini API key from https://aistudio.google.com
# (Get API key). Without it the app works, but pages with pictures aren't read.
# The chat model (Stage 7) is chosen later.
GEMINI_API_KEY=

# Optional, image reader. Defaults shown (free-tier limits from AI Studio > Rate limit).
# VISION_MODEL=gemini-3.8-flash
# VISION_FALLBACK_MODEL=gemini-3.5-flash-lite   (used when the main model's daily quota is used up)
# VISION_MODEL_RPM=5
# VISION_MODEL_RPD=20
# VISION_FALLBACK_RPM=15
# VISION_FALLBACK_RPD=500
# VISION_PAGES_PER_REQUEST=5
# VISION_MAX_ATTEMPTS=3
# PAGE_IMAGE_LONG_SIDE=2000

# Optional, embeddings (Stage 6): local model for meaning search. Defaults shown.
# The model is downloaded once (~1.2 GB) into the Hugging Face cache.
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# EMBEDDING_DEVICE=auto        (auto = GPU if available, else CPU; or cpu / cuda)
# EMBEDDING_BATCH_SIZE=16      (lower it if the GPU runs out of memory)
# EMBEDDING_ENABLED=true       (false = don't load the model; meaning search is off)
