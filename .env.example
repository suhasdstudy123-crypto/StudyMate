# Copy this file to backend/.env and fill in real values.
# Never commit the real .env file (it is in .gitignore).

# PostgreSQL connection string (pgvector-enabled database)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:your_password@localhost:5433/studymate

# Secret used to sign JWT auth tokens (Phase 4)
JWT_SECRET_KEY=

# API key for the LLM provider used by the RAG pipeline (Phase 7)
LLM_API_KEY=
